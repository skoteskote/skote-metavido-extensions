--- !u!114 &27
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3dce580c03fa4404bb6d87662050fbf1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 2}
  m_Children: []
  m_UIPosition: {x: 1502.5487, y: 240.3539}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 71}
  - {fileID: 34}
  - {fileID: 88}
  - {fileID: 89}
  m_OutputSlots:
  - {fileID: 40}
  m_OperatorName: Custom HLSL
  m_HLSLCode: "float3 MetavidoInverseProjection(\n    float3   uvDepth,\n  float4  
    RayParams, \n  float4x4 InverseView,\n  float2   TargetAspectWH \n)\n{\n  const
    float SRC_ASPECT = 16.0f / 9.0f;\n\n    float2 UV    = uvDepth.xy;\n    float 
    Depth = uvDepth.z;\n\n  float tgtAspect = TargetAspectWH.x / max(TargetAspectWH.y,
    1e-6f);\n\n  // Crop around center based on target aspect\n  if (tgtAspect <=
    SRC_ASPECT)\n  {\n    // Narrower than 16:9 \u2192 crop left/right\n    float
    scaleU = SRC_ASPECT / tgtAspect;           // >= 1\n    UV.x = (UV.x - 0.5f)
    * scaleU + 0.5f;\n\n    // Compensate horizontal ray scale (was 9/16 for square)\n   
    RayParams.z *= (1.0f / scaleU);\n  }\n  else\n  {\n    // Wider/taller than 16:9
    \u2192 crop top/bottom\n    float scaleV = tgtAspect / SRC_ASPECT;          
    // >= 1\n    UV.y = (UV.y - 0.5f) * scaleV + 0.5f;\n\n    // Compensate vertical
    ray scale\n    RayParams.w *= (1.0f / scaleV);\n  }\n\n  // Discard particles
    outside the crop area\n  if (UV.x < 0.0f || UV.x > 1.0f || UV.y < 0.0f || UV.y
    > 1.0f)\n  {\n    return float3(0, 0, 0);\n  }\n\n  // Unchanged projection\n 
    float3 p = float3(UV * 2.0f - 1.0f, 1.0f);\n  p.xy = (p.xy + RayParams.xy) *
    RayParams.zw;\n  p *= Depth;\n  return mul(InverseView, float4(p, 1)).xyz;\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: MetavidoInverseProjection
    selectedIndex: 0
